# Keep Cloudflare preview addresses out of Google.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Read by the Las Cruces Events calendar's build (another site), so it needs this.
/directory.json
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex
