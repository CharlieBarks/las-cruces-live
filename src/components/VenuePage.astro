---
// One venue's page. Used by /venues/<slug>/ and, on the preview site, by the private edit link
// (/share/<token>/), which adds the editor on top. Same pattern as MusicianPage.
import Layout from '../layouts/Layout.astro';
import ThisWeek from './ThisWeek.astro';
import VenueMap from './VenueMap.astro';
import Comments from './Comments.astro';
import CrowdPhotos from './CrowdPhotos.astro';
import PinnedPosts from './PinnedPosts.astro';
import PreviewBar from './PreviewBar.astro';
import AdminBar from './AdminBar.astro';
import Editor from './Editor.astro';
import { SITE, PREVIEW, hoursRows, venueClosures, utm, out, venues, venueWeek, musicianBySlug, AREAS, mapsLink, whenText, listJoin, venueJsonLd, breadcrumbJsonLd, isFeaturedVenue, isSponsorVenue, featuredVenueFirst } from '../lib/site.js';

const { v, share = false } = Astro.props;
const gallery = v.gallery || [];
const hours = hoursRows(v.hours);
// Closure notice: shown until the day after Notice Until (Las Cruces time). The build skips expired
// ones, and the script below hides one that expires between builds.
const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Denver' });
const notice = v.notice && (!v.noticeUntil || v.noticeUntil >= today) ? v.notice : '';
// "Venue | CLOSED – why" lines from the Thursday issue
const closures = venueClosures(v);
const claimUrl = `/claim/?id=${v.notionId}&name=${encodeURIComponent(v.name)}&kind=venue`;
const area = AREAS[v.area];
const w = venueWeek(v);
const acts = w.acts.map(musicianBySlug).filter(Boolean);
const LINKS = [['website', 'Website'], ['facebook', 'Facebook'], ['instagram', 'Instagram']];
const links = LINKS.filter(([k]) => v.links[k]);
const feat = isFeaturedVenue(v);
const nearby = featuredVenueFirst(venues.filter((x) => x.area === v.area && x.slug !== v.slug)).slice(0, 6);
const sponsor = isSponsorVenue(v);
// Everyone playing: acts with a page here (linked), then performers by the name in the issue
const otherNames = w.others || [];
const allNames = [...acts.map((a) => a.name), ...otherNames];
const missing = Math.max(0, (w.unlisted ?? 0) - otherNames.length);
const when = whenText(w.weeks);
const heading = allNames.length > 4
  ? `${w.shows} shows at ${v.name} ${when}. Here's who's playing.`
  : allNames.length
  ? `${listJoin(allNames)}${missing > 0 ? `, plus ${missing} more ${missing === 1 ? 'show' : 'shows'}` : ''}.`
  : `${w.shows} ${w.shows === 1 ? 'show' : 'shows'} at ${v.name} ${when}.`;
// Who's playing, split by week: this week first, next week (if the issue has it) folded below
const weekLists = (w.byWeek || []).map((x, i) => ({
  label: i === 0 ? 'this week' : 'next week',
  acts: x.acts.map(musicianBySlug).filter(Boolean),
  others: x.others,
})).filter((x) => x.acts.length + x.others.length > 0);
const lllc = utm('https://livelovelascruces.com/', `venue_${v.slug}_sponsor`);
---
<Layout title={`${v.name}, Live Music in ${area?.name === 'Old Mesilla' ? 'Mesilla' : 'Las Cruces'}`} description={`Live music at ${v.name}${v.address ? `, ${v.address}` : ''}. Links, directions and who's playing this week and next.`} jsonLd={[venueJsonLd(v), breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Venues', path: '/venues/' }, { name: v.name, path: `/venues/${v.slug}/` }])]} image={v.share} imageAlt={v.share ? `${v.name}, live music venue` : ''} searchable={!share} noindex={share}>
  {PREVIEW && !share && <PreviewBar m={v} kind="venue" />}
  {!PREVIEW && !share && <AdminBar m={v} kind="venue" />}
  {share && <Editor m={v} kind="venue" />}
  <div class="wrap">
    <p class="crumbs" data-pagefind-ignore><a href="/">Home</a> / <a href="/venues/">Venues</a> / {v.name}</p>
    {notice && <p class="notice" role="status" data-until={v.noticeUntil || undefined}><strong>Heads up:</strong> {notice}</p>}
    {closures.map((c) => <p class="notice" role="status" data-until={c.date}><strong>Closed {c.label}</strong>{c.reason && ` for ${c.reason.replace(/^for\s+/i, '').replace(/^./, (x) => x.toLowerCase())}`}.</p>)}
    <article class:list={['grid', { feat }]}>
      <div class="main stack">
        {v.photo && <img class="vphoto" src={v.photo} alt={`${v.name}, live music venue in ${area?.name === 'Old Mesilla' ? 'Mesilla' : 'Las Cruces'}`} width="1200" height="900" decoding="async" fetchpriority="high" />}
        {(feat || w.shows > 0) && (
          <div class="tags">
            {sponsor ? <a class="fpill" href={lllc} rel="noopener">★ Proud sponsor of Live Love Las Cruces</a> : feat && <p class="fpill">Featured venue</p>}
            {w.shows > 0 && <p class="playing">Live music {whenText(w.weeks, true)}</p>}
          </div>
        )}
        <h1>{v.name}</h1>
        <p class="kind"><a href={`/venues/#${v.area}`}>{area?.name}</a></p>
        {v.about && <p class="about">{v.about}</p>}
        <dl class="facts">
          {v.address && <><dt>Address</dt><dd>{v.address}<br /><a href={mapsLink(v)} rel="noopener">Get directions</a></dd></>}
          {v.phone && <><dt>Phone</dt><dd><a href={`tel:${v.phone.replace(/[^\d+]/g, '')}`}>{v.phone}</a></dd></>}
          {hours.length > 0 && <><dt>Hours</dt><dd><table class="hours"><tbody>{hours.map((h) => <tr><th scope="row">{h.days}</th><td>{h.when}</td></tr>)}</tbody></table>{v.hoursNote && <p class="hnote">{v.hoursNote}</p>}</dd></>}
        </dl>
        {links.length > 0 && <div class="btns">{links.map(([k, n]) => <a class="btn btn-line" href={out(v.links[k], v.slug)} rel="noopener">{n}</a>)}</div>}
        {v.lat && v.lng && <div class="mini"><VenueMap list={[v]} height="300px" zoom={14} /></div>}
        {gallery.length > 0 && (
          <section class="photos" aria-label="Photos">
            <h2>Photos</h2>
            <ul class={`gallery n${Math.min(gallery.length, 5)}`}>
              {gallery.map((g) => (
                <li><a href={g.src} target="_blank" rel="noopener" aria-label={`${g.caption || `${v.name} photo`}, full size (opens in a new tab)`}><img src={g.src} alt={g.caption || `${v.name} photo`} loading="lazy" />{g.caption && <span aria-hidden="true">{g.caption}</span>}</a></li>
              ))}
            </ul>
          </section>
        )}
      </div>
      <div class="side stack">
        {w.shows > 0 ? (
          <ThisWeek heading={heading} source={`venue_${v.slug}`} when={whenText(w.weeks, true)} />
        ) : (
          <ThisWeek idle heading={`See who's playing ${v.name}.`} body="Every Thursday the Live Music issue lists the week's shows here and all over town." source={`venue_${v.slug}`} />
        )}
        {weekLists.length > 0 && (
          <div class="acts-here" data-pagefind-ignore>
            {weekLists.map((wk, i) => {
              const list = (
                <ul>
                  {wk.acts.map((a) => <li><a href={`/musicians/${a.slug}/`}>{a.name} <span class="go" aria-hidden="true">→</span></a></li>)}
                  {wk.others.map((n) => <li><span class="nolink">{n}</span></li>)}
                </ul>
              );
              // This week shows open; next week sits folded under it when both are in the issue
              return i === 0 || weekLists.length === 1
                ? <><p class="label">Playing here {wk.label}</p>{list}</>
                : <details class="next"><summary>See who's playing here {wk.label} ({wk.acts.length + wk.others.length})</summary>{list}</details>;
            })}
            {weekLists.some((wk) => wk.others.length) && <p class="addme">Playing here without a page? <a class="addlink" href="/get-listed/">Get one free →</a></p>}
          </div>
        )}
        {sponsor && (
          <aside class="sponsor-box" data-pagefind-ignore>
            <a href={lllc} rel="noopener"><img src="/lllc-logo-on-light.png" alt="Live Love Las Cruces" width="200" height="50" loading="lazy" /></a>
            <p><strong>{v.name} is a proud sponsor of Live Love Las Cruces</strong>, helping bring every show in town to 10,000+ locals in Thursday's free Live Music issue. Thank you!</p>
          </aside>
        )}
        <aside class="shows-cta" data-pagefind-ignore>
          <p><strong>Got shows coming up?</strong> <a href={utm(SITE.eventsUrl, `venue_${v.slug}`)} rel="noopener">Make sure we know about it: add it to the Events Calendar →</a></p>
        </aside>
        {!share && (
          <aside class="claim" data-pagefind-ignore>
            <p class="claim-head">Run this venue?</p>
            <p>{v.claimed
              ? 'Need to change something on this page? Ask for your private edit link.'
              : 'Claim this page, free. Add your photos, a few lines about the place and your links. Claimed venues are listed first.'}</p>
            <a class="btn btn-chile" href={claimUrl}>{v.claimed ? 'Edit this page' : 'Claim this page'}</a>
            {!feat && <p class="upsell">Want a gold pin on the map and a top spot? <a href="/get-listed/#venues">See sponsor options</a></p>}
          </aside>
        )}
      </div>
    </article>
    <PinnedPosts record={v} about={v.name} />
    {!share && <CrowdPhotos record={v} kind="venue" about={v.name} />}
    {!share && <Comments record={v} kind="venue" about={v.name} prompt={`What do you love about ${v.name}?`} placeholder="The patio, the crowd, the music, the best night you had there…" />}
    {nearby.length > 0 && (
      <section class="nearby" data-pagefind-ignore>
        <h2>More in {area?.name}</h2>
        <ul>{nearby.map((x) => <li><a href={`/venues/${x.slug}/`}>{x.name}</a>{isFeaturedVenue(x) && <em class="ftag">Featured</em>}</li>)}</ul>
      </section>
    )}
  </div>
</Layout>

<script is:inline>
  // Hide a closure notice once its last day has passed in Las Cruces, even before the next rebuild
  (function () {
    try {
      var today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Denver' });
      document.querySelectorAll('.notice[data-until]').forEach(function (n) { if (today > n.getAttribute('data-until')) n.hidden = true; });
    } catch (e) {}
  })();
</script>

<style>
  .notice + .notice { margin-top: 8px; }
  .notice { margin: 4px 0 0; padding: 12px 16px; border-radius: 8px; background: var(--gold); color: var(--night); font-size: 1.05rem; }
  .notice[hidden] { display: none; }
  .hours { border-collapse: collapse; }
  .hours th { text-align: left; font-weight: 600; padding: 0 16px 4px 0; white-space: nowrap; }
  .hours td { padding: 0 0 4px; }
  .hnote { font-size: .92rem; color: var(--muted); margin-top: 4px; }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  a.fpill { text-decoration: none; }
  a.fpill:hover { background: var(--night); color: var(--gold); }
  .acts-here .nolink { display: block; padding: 8px 0; font: 700 1.35rem/1.1 var(--display); color: var(--muted); }
  .acts-here .go { color: var(--turq); font-size: 1.1rem; }
  .acts-here a.addlink { display: inline; padding: 0; font: 700 .92rem var(--text); color: var(--turq); text-decoration: underline; }
  .next { margin-top: 14px; }
  .next summary { cursor: pointer; font-weight: 700; color: var(--turq); min-height: 44px; display: flex; align-items: center; }
  .next summary:hover { text-decoration: underline; }
  .addme { margin-top: 10px; font-size: .92rem; color: var(--muted); }
  .sponsor-box { display: grid; gap: 10px; padding: 20px; border-radius: 10px; background: var(--cream); box-shadow: inset 0 0 0 3px var(--gold); }
  .sponsor-box img { display: block; width: 180px; height: auto; }
  .fpill { justify-self: start; display: inline-block; background: var(--gold); color: var(--night); font-weight: 700; font-size: .85rem; padding: 5px 12px; border-radius: 999px; }
  .feat h1 { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 8px; text-underline-offset: 6px; text-decoration-skip-ink: none; }
  .ftag { font: 700 .7rem var(--text); font-style: normal; background: var(--gold); color: var(--night); padding: 2px 7px; border-radius: 999px; margin-left: 8px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr); gap: 48px; padding: 20px 0 56px; align-items: start; }
  h1 { font-size: clamp(3rem, 7.5vw, 6rem); }
  .kind { font-size: 1.15rem; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 10px 20px; margin: 8px 0 0; padding-top: 18px; border-top: 2px solid var(--ink); }
  dt { font-weight: 700; } dd { margin: 0; }
  .mini { margin-top: 12px; }
  .vphoto { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 25%; border-radius: 8px; }
  .acts-here .label { font-weight: 700; margin-bottom: 6px; }
  .acts-here ul { list-style: none; padding: 0; margin: 0; }
  .acts-here li { border-bottom: 1px solid var(--line); }
  .acts-here a { display: block; padding: 8px 0; font: 700 1.35rem/1.1 var(--display); color: var(--ink); text-decoration: none; }
  .acts-here a:hover { color: var(--turq); }
  .shows-cta { padding: 14px 18px; border-left: 4px solid var(--chile); background: var(--paper); border-radius: 8px; }
  .claim { border: 1px dashed var(--turq); border-radius: 10px; padding: 22px; display: grid; gap: 10px; justify-items: start; }
  .upsell { font-size: .92rem; color: var(--muted); }
  .about { font-size: 1.1rem; max-width: 60ch; white-space: pre-line; }
  .photos { display: grid; gap: 12px; margin-top: 18px; }
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
  .gallery li { grid-column: span 2; }
  .gallery.n1 li { grid-column: span 6; }
  .gallery.n2 li, .gallery.n4 li { grid-column: span 3; }
  .gallery.n3 li:first-child, .gallery.n5 li:first-child { grid-column: span 6; }
  .gallery.n3 li:not(:first-child) { grid-column: span 3; }
  .gallery.n5 li:nth-child(2), .gallery.n5 li:nth-child(3) { grid-column: span 3; }
  .gallery a { position: relative; display: block; border-radius: 10px; overflow: hidden; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; transition: transform 0.3s; }
  .gallery li:first-child img { aspect-ratio: 16 / 9; }
  .gallery.n2 li:first-child img, .gallery.n4 li:first-child img { aspect-ratio: 4 / 3; }
  .gallery a:hover img { transform: scale(1.03); }
  .gallery span { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 12px 8px; font-size: 0.85rem; color: #fff; background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 40%, rgba(0, 0, 0, 0)); text-shadow: 0 1px 2px #000; }
  @media (prefers-reduced-motion: reduce) { .gallery img { transition: none; } .gallery a:hover img { transform: none; } }
  @media (max-width: 860px) { .gallery li, .gallery.n3 li:not(:first-child) { grid-column: span 3; } }
  .claim-head { font: 800 1.5rem/1 var(--display); }
  .nearby { padding-bottom: 72px; }
  .nearby ul { columns: 3 220px; padding-left: 18px; margin-top: 14px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
