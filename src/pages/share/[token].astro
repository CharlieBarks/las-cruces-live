---
// Private edit links: one page per act or venue with a share token, built only on the preview site.
// The address holds a random token, so only the person it's emailed to can find it.
import MusicianPage from '../../components/MusicianPage.astro';
import VenuePage from '../../components/VenuePage.astro';
import { musicians, venues, PREVIEW } from '../../lib/site.js';

export function getStaticPaths() {
  if (process.env.LIVE_PREVIEW !== '1') return [];
  return [
    ...musicians.filter((m) => m.shareToken).map((m) => ({ params: { token: m.shareToken }, props: { m } })),
    ...venues.filter((v) => v.shareToken).map((v) => ({ params: { token: v.shareToken }, props: { v } })),
  ];
}
const { m, v } = Astro.props;
---
{PREVIEW && m && <MusicianPage m={m} share />}
{PREVIEW && v && <VenuePage v={v} share />}
