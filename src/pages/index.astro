---
import Layout from '../layouts/Layout.astro';
import Stage from '../components/Stage.astro';
import ActCard from '../components/ActCard.astro';
import SponsorBand from '../components/SponsorBand.astro';
import VenueCard from '../components/VenueCard.astro';
import { SITE, WHEN_SHORT, musicians, venues, genres, playingActs, venueWeek, issueLink, SPONSORS, isFeatured, isFeaturedVenue } from '../lib/site.js';

// Who gets a card: everyone playing this week (featured first), shuffled in the browser on every
// visit so each act gets the same shot at the top spots. In a week with no lineup, a mix of
// local acts instead, with photo acts in the pool first.
const SHOW = 8;
const featuredFirst = (a) => [...a.filter(isFeatured), ...a.filter((m) => !isFeatured(m))];
const hasLineup = playingActs.length > 0;
const pool = hasLineup
  ? featuredFirst(playingActs)
  : featuredFirst([...musicians.filter((m) => m.photo), ...musicians.filter((m) => !m.photo)]).slice(0, 40);
// Where they play: sponsor venues get wide cards up top (in the order of SPONSORS.liveMusic), then
// 8 venue cards in a fresh order every visit, with venues playing this week first.
const sponsorOrder = (SPONSORS.liveMusic || []).map((s) => s.venue);
const sponsorVenues = venues.filter(isFeaturedVenue)
  .sort((a, b) => ((sponsorOrder.indexOf(a.slug) + 1) || 99) - ((sponsorOrder.indexOf(b.slug) + 1) || 99));
const VENUE_SHOW = 8;
const venuePool = venues.filter((v) => !isFeaturedVenue(v)).sort((a, b) => Number(venueWeek(b).shows > 0) - Number(venueWeek(a).shows > 0));
const sponsor = SPONSORS.home;
---
<Layout
  title={SITE.name}
  description={`Meet the local musicians and bands of Las Cruces and Mesilla, see who's playing this week, find them by genre, and find the venues that host live music across the Mesilla Valley.`}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, potentialAction: { '@type': 'SearchAction', target: `${SITE.url}/search/?q={q}`, 'query-input': 'required name=q' } }]}
>
  <section class="hero night on-night">
    <Stage />
    <div class="wrap inner">
      <p class="kicker">Las Cruces + Mesilla, New Mexico</p>
      <h1>The best band in town is probably playing down the street.</h1>
      <p class="sub">Meet the musicians of Las Cruces and Mesilla. Then go hear them.</p>
    </div>
  </section>

  <SponsorBand source="home" />
  {sponsor && (
    <div class="sponsor wrap"><span>Presented by</span> <a href={sponsor.url}>{sponsor.name}</a></div>
  )}

  <section class="section acts-band">
    <div class="wrap stack">
      <div class="head-row">
        <div class="stack-tight">
          <h2>{hasLineup ? `Playing ${WHEN_SHORT}` : 'Meet the musicians'}</h2>
          {hasLineup
            ? <p class="lede">Tap an act to meet them. Days, times and venues are in <a href={issueLink('home_acts')}>Thursday's Live Music issue</a>.</p>
            : <p class="lede">A different handful every visit.</p>}
        </div>
      </div>
      <ul class="cards" data-shuffle data-show={SHOW} aria-label={hasLineup ? `Acts playing ${WHEN_SHORT}` : 'Local acts'}>
        {pool.map((m) => <li data-pin={isFeatured(m) ? '1' : undefined}><ActCard m={m} /></li>)}
      </ul>
      {hasLineup
        ? <a class="more" href="/this-week/">See all {playingActs.length} acts playing {WHEN_SHORT} →</a>
        : <a class="more" href="/musicians/">See every act →</a>}
    </div>
  </section>

  <section class="section tight">
    <div class="wrap stack">
      <h2>Find your sound</h2>
      <ul class="chips">
        {genres.map((g) => <li><a href={`/genres/${g.slug}/`}>{g.name}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section venues-band">
    <div class="wrap stack">
      <div class="stack-tight">
        <h2>Where they play</h2>
        <p class="lede">Patios, wineries, breweries and roadhouses all over the valley.{venues.some((v) => venueWeek(v).shows > 0) && ` Gold tags have live music ${WHEN_SHORT}.`}</p>
      </div>
      {sponsorVenues.length > 0 && (
        <ul class="vsponsors" aria-label="Sponsor venues">
          {sponsorVenues.map((v) => <li><VenueCard v={v} wide /></li>)}
        </ul>
      )}
      <ul class="cards vcards" data-vshuffle data-show={VENUE_SHOW} aria-label="Venues">
        {venuePool.map((v) => <li data-playing={venueWeek(v).shows > 0 ? '1' : undefined}><VenueCard v={v} /></li>)}
      </ul>
      <div class="btns"><a class="btn btn-gold" href="/map/">Open the venue map</a><a class="btn btn-line" href="/venues/">All {venues.length} venues</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split listed">
      <div class="stack-tight">
        <h2>Play music here? Your page is free.</h2>
        <p class="lede">Add your photo, your story, a song and a Book button so venues can reach you. Then put your shows on the events calendar so they make Thursday's issue.</p>
      </div>
      <div class="btns">
        <a class="btn btn-chile" href="/get-listed/">Get listed free</a>
        <a class="btn btn-line" href="/get-listed/#venues">Feature your venue</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  // Fresh order on every visit so every act gets equal time up top. Featured (paid) acts stay first.
  document.querySelectorAll('[data-shuffle]').forEach(function (ul) {
    var items = Array.prototype.slice.call(ul.children);
    var pinned = items.filter(function (li) { return li.dataset.pin; });
    var rest = items.filter(function (li) { return !li.dataset.pin; });
    for (var i = rest.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = rest[i]; rest[i] = rest[j]; rest[j] = t; }
    var show = Number(ul.dataset.show) || items.length;
    pinned.concat(rest).forEach(function (li, k) { li.hidden = k >= show; ul.appendChild(li); });
  });
  // Venues: fresh order every visit, venues with live music this week first
  document.querySelectorAll('[data-vshuffle]').forEach(function (ul) {
    var mix = function (a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; };
    var items = Array.prototype.slice.call(ul.children);
    var show = Number(ul.dataset.show) || items.length;
    mix(items.filter(function (li) { return li.dataset.playing; })).concat(mix(items.filter(function (li) { return !li.dataset.playing; })))
      .forEach(function (li, k) { li.hidden = k >= show; ul.appendChild(li); });
  });
</script>

<style>
  .hero { padding: clamp(56px, 8vw, 104px) 0 clamp(64px, 9vw, 120px); position: relative; overflow: hidden; }
  .inner { position: relative; z-index: 1; text-align: center; display: grid; justify-items: center; gap: 16px; }
  .kicker { color: var(--turq-bright) !important; font-weight: 700; font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .hero h1 { color: var(--cream); max-width: 15ch; text-wrap: balance; }
  .sub { font-size: 1.2rem; max-width: 46ch; }
  .sponsor { padding-top: 14px; font-size: 0.9rem; color: var(--muted); }
  .stack { display: grid; gap: 28px; }
  .stack-tight { display: grid; gap: 10px; }
  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px 24px; flex-wrap: wrap; }
  .more { justify-self: start; font-weight: 700; font-size: 1.15rem; min-height: 44px; display: inline-flex; align-items: center; }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr 1fr !important; gap: 12px !important; } }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
  /* Without JavaScript, still show only the first 8 */
  .cards[data-show='8'] > li:nth-child(n + 9) { display: none; }
  .cards > li[hidden] { display: none; }
  .cards > li:not([hidden]) { display: block; }
  .tight { padding-top: 0; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chips a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 2px solid var(--ink); border-radius: 999px; color: var(--ink); text-decoration: none; font-weight: 700; }
  .chips a:hover { background: var(--ink); color: var(--cream); }
  .venues-band { background: var(--sky); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .venues-band .lede { color: var(--ink); }
  .vsponsors { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 20px; }
  .split { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px 56px; }
  .split > .stack-tight { flex: 1 1 520px; }
  .listed { border-top: 2px solid var(--ink); padding-top: 40px; }
</style>
