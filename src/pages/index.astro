---
import Layout from '../layouts/Layout.astro';
import { SITE, musicians, venues, genres, playingActs, thisWeek, venueWeek, issueLink, subscribeLink, AREAS, SPONSORS } from '../lib/site.js';

const busy = venues
  .map((v) => ({ v, w: venueWeek(v) }))
  .filter((x) => x.w.shows > 0)
  .sort((a, b) => b.w.shows - a.w.shows || a.v.name.localeCompare(b.v.name));
const areaCounts = Object.entries(AREAS)
  .map(([k, a]) => ({ k, a, n: venues.filter((v) => v.area === k).length }))
  .filter((x) => x.n > 0);
const playing = new Set(playingActs.map((m) => m.slug));
const sponsor = SPONSORS.home;
---
<Layout
  title={SITE.name}
  description={`Meet the ${musicians.length} local musicians and bands of Las Cruces and Mesilla, find them by genre, and see the venues that host live music across the Mesilla Valley.`}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url, potentialAction: { '@type': 'SearchAction', target: `${SITE.url}/search/?q={q}`, 'query-input': 'required name=q' } }]}
>
  <section class="hero night on-night">
    <div class="wrap">
      <h1>Every band, singer and stage in Las Cruces.</h1>
      <p class="sub">{musicians.length} local acts and {venues.length} places to hear them, from Hatch to the Texas line.</p>

      <p class="sr-only">The full lineup of local acts follows. Acts playing this week are highlighted.</p>
      <ul class="wall" aria-label="Local acts">
        {musicians.map((m) => (
          <li class={playing.has(m.slug) ? 'on' : undefined}>
            <a href={`/musicians/${m.slug}/`}>{m.name}</a>
          </li>
        ))}
      </ul>

      {thisWeek.shows > 0 ? (
        <div class="cta">
          <p class="cta-head"><span class="glow">{playingActs.length} of them</span> are on stage this week, in {thisWeek.shows} shows across the valley.</p>
          <p>Days and times land in Thursday's Live Music issue.</p>
          <div class="btns">
            <a class="btn btn-gold" href={issueLink('home_hero')}>See this week's days and times</a>
            <a class="btn btn-line" href={subscribeLink('home_hero')}>Get it free every Thursday</a>
          </div>
        </div>
      ) : (
        <div class="cta">
          <p class="cta-head">Want to know who's playing where?</p>
          <p>The week's live music lands every Thursday at 1 pm, free.</p>
          <div class="btns"><a class="btn btn-gold" href={subscribeLink('home_hero')}>Get the Thursday issue</a></div>
        </div>
      )}
    </div>
  </section>

  {sponsor && (
    <div class="sponsor wrap"><span>Presented by</span> <a href={sponsor.url}>{sponsor.name}</a></div>
  )}

  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <h2>Find your sound</h2>
        <a href="/musicians/">Browse all {musicians.length} acts</a>
      </div>
      <ul class="genres">
        {genres.map((g) => (
          <li><a href={`/genres/${g.slug}/`}><span>{g.name}</span><span class="n">{g.acts.length}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section venues-band">
    <div class="wrap split">
      <div class="stack">
        <h2>Where the music happens</h2>
        <p class="lede">Wineries, brewery patios, plaza cantinas and roadhouses. These stages had the most going on in the latest issue.</p>
        <ol class="busy">
          {busy.slice(0, 8).map(({ v, w }) => (
            <li><a href={`/venues/${v.slug}/`}>{v.name}</a><span>{w.shows} {w.shows === 1 ? 'show' : 'shows'} this week</span></li>
          ))}
        </ol>
        <div class="btns"><a class="btn btn-line" href="/map/">Open the venue map</a><a class="btn btn-line" href="/venues/">All {venues.length} venues</a></div>
      </div>
      <div class="areas">
        <h3>By neighborhood</h3>
        <ul>
          {areaCounts.map(({ k, a, n }) => (
            <li><a href={`/venues/#${k}`}>{a.name}</a><span>{n}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap listed">
      <h2>Play music here, or book it?</h2>
      <p class="lede">Every local musician, band and venue gets a free listing. Tell me what to add or fix and I'll get it up.</p>
      <div class="btns">
        <a class="btn btn-chile" href="/get-listed/">Get listed free</a>
        <a class="btn btn-line" href="/get-listed/#venues">Feature your venue</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding: clamp(40px, 6vw, 72px) 0 clamp(48px, 7vw, 80px); position: relative; overflow: hidden; }
  .hero h1 { color: var(--cream); max-width: 19ch; text-wrap: balance; }
  .sub { margin-top: 16px; font-size: 1.2rem; }

  /* The lineup poster: every act, this week's in gold */
  .wall { list-style: none; margin: 40px 0 0; padding: 28px 0; border-top: 2px solid rgba(245,239,226,.25); border-bottom: 2px solid rgba(245,239,226,.25);
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 0; font-family: var(--display); text-transform: uppercase; line-height: 1.15; text-align: justify; }
  .wall li { font-size: clamp(0.95rem, 1.5vw, 1.2rem); font-weight: 600; letter-spacing: 0.02em; }
  .wall li::after { content: '✦'; color: var(--turq-bright); margin: 0 0.55em; font-size: 0.6em; vertical-align: 0.2em; }
  .wall li:last-child::after { content: none; }
  .wall a { color: rgba(245,239,226,.55); text-decoration: none; }
  .wall a:hover { color: var(--cream); }
  .wall li.on { font-size: clamp(1.35rem, 2.6vw, 2.1rem); font-weight: 900; }
  .wall li.on a { color: var(--gold); }
  .wall li.on a:hover { color: #ffd27a; }

  .cta { margin-top: 32px; display: grid; gap: 10px; }
  .cta-head { font: 800 clamp(1.7rem, 3.4vw, 2.5rem)/1.02 var(--display); color: var(--cream) !important; max-width: 26ch; }
  .glow { color: var(--gold); }
  .cta .btns { margin-top: 8px; }

  .sponsor { padding-top: 14px; font-size: 0.9rem; color: var(--muted); }

  .head-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .genres { list-style: none; margin: 0; padding: 0; columns: 3 260px; column-gap: 40px; }
  .genres li { break-inside: avoid; border-bottom: 1px solid var(--line); }
  .genres a { display: flex; justify-content: space-between; align-items: baseline; padding: 12px 2px; text-decoration: none; color: var(--ink); font: 700 1.55rem/1.05 var(--display); }
  .genres a:hover { color: var(--turq); }
  .n { font: 600 0.95rem var(--text); color: var(--muted); }

  .venues-band { background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .split { display: grid; grid-template-columns: 1.5fr 1fr; gap: 56px; }
  .busy { list-style: none; margin: 8px 0 0; padding: 0; counter-reset: none; }
  .busy li { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .busy a { font: 700 1.35rem/1.1 var(--display); color: var(--ink); text-decoration: none; }
  .busy a:hover { color: var(--turq); }
  .busy span { color: var(--chile); font-weight: 600; font-size: 0.92rem; white-space: nowrap; }
  .areas h3 { margin-bottom: 12px; }
  .areas ul { list-style: none; margin: 0; padding: 0; }
  .areas li { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--line); }
  .areas span { color: var(--muted); }

  .listed { display: grid; gap: 16px; justify-items: start; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }
</style>
