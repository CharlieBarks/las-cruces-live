---
// Preview site only: everything waiting for Charlie. New acts from the form, claim requests from
// people whose email isn't on file, and owners' changes to live pages.
import Layout from '../../layouts/Layout.astro';
import { musicians, PREVIEW } from '../../lib/site.js';
import commentsRaw from '../../data/comments.json';
const comments = PREVIEW ? commentsRaw : [];
const newActs = musicians.filter((m) => m.siteStatus === 'Submitted' || m.siteStatus === 'In Review');
const claims = musicians.filter((m) => m.claimRequest);
const pending = musicians.filter((m) => m.pendingEdits);
const empty = !newActs.length && !claims.length && !pending.length && !comments.length;
---
<Layout title="Review queue" description="Waiting for approval" noindex>
  <div class="wrap q">
    {!PREVIEW ? <p>Not here.</p> : (
      <>
        <h1>Review queue</h1>
        {empty && <p class="lede">All caught up. Nothing is waiting.</p>}
        {newActs.length > 0 && (
          <section>
            <h2>New acts ({newActs.length})</h2>
            <ul>{newActs.map((m) => <li><a href={`/musicians/${m.slug}/`}>{m.name}</a> <span>{m.siteStatus}{m.submittedOn && ` · ${m.submittedOn}`}{m.submitter && ` · ${m.submitter}`}</span></li>)}</ul>
          </section>
        )}
        {claims.length > 0 && (
          <section>
            <h2>Claim requests ({claims.length})</h2>
            <ul>{claims.map((m) => <li><a href={`/musicians/${m.slug}/`}>{m.name}</a> <span>{m.claimRequest.split('\n')[0]}</span></li>)}</ul>
          </section>
        )}
        {pending.length > 0 && (
          <section>
            <h2>Changes to live pages ({pending.length})</h2>
            <ul>{pending.map((m) => <li><a href={`/musicians/${m.slug}/`}>{m.name}</a> <span>{(m.pendingEdits.at || '').slice(0, 10)}</span></li>)}</ul>
          </section>
        )}
        {comments.length > 0 && (
          <section>
            <h2>New comments ({comments.length})</h2>
            <ul class="cm">
              {comments.map((c) => (
                <li data-comment={c.id}>
                  <blockquote>“{c.text}”</blockquote>
                  <p class="by">{[c.firstName, c.town].filter(Boolean).join(', ')}{c.date && ` · ${c.date}`} · on {c.aboutHref ? <a href={c.aboutHref}>{c.aboutName}</a> : (c.aboutName || 'a page')}</p>
                  <div class="row">
                    <button class="btn btn-gold" type="button" data-set="Approved">Approve</button>
                    <button class="btn btn-line" type="button" data-set="Hidden">Hide</button>
                    <span class="msg" role="status" aria-live="polite"></span>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}
        <p class="tip">Open an act to Approve it, send the edit link or apply their changes. This page refreshes about 2 minutes after anything changes.</p>
      </>
    )}
  </div>
</Layout>
<script is:inline>
  // Approve / Hide a comment. The preview Worker checks Charlie's login and passes it to the intake Worker.
  document.querySelectorAll('[data-comment]').forEach(function (li) {
    var msg = li.querySelector('.msg');
    li.querySelectorAll('[data-set]').forEach(function (b) {
      b.addEventListener('click', function () {
        var status = b.getAttribute('data-set');
        li.querySelectorAll('button').forEach(function (x) { x.disabled = true; });
        msg.textContent = 'Saving…';
        fetch('/api/comment', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: li.getAttribute('data-comment'), status: status }) })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d.ok) throw new Error(d.error || 'Something went wrong.');
            msg.textContent = status === 'Approved' ? 'Approved. It shows on the page in about 2 minutes.' : 'Hidden. It will never show.';
            li.classList.add('done');
          })
          .catch(function (e) { msg.textContent = e.message; li.querySelectorAll('button').forEach(function (x) { x.disabled = false; }); });
      });
    });
  });
</script>
<style>
  .q { padding: 32px 0 80px; display: grid; gap: 24px; }
  section { border-top: 2px solid var(--ink); padding-top: 14px; }
  h2 { margin-bottom: 10px; }
  ul { margin: 0; padding-left: 20px; display: grid; gap: 8px; }
  li span { color: var(--muted); font-size: 0.95rem; margin-left: 6px; }
  .tip { color: var(--muted); }
  .cm { list-style: none; padding: 0; gap: 14px; }
  .cm li { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; display: grid; gap: 8px; }
  .cm li.done { opacity: .6; }
  .cm blockquote { margin: 0; font-size: 1.1rem; }
  .by { color: var(--muted); font-size: .92rem; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
</style>
