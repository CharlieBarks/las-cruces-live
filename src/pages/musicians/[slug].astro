---
import Layout from '../../layouts/Layout.astro';
import ThisWeek from '../../components/ThisWeek.astro';
import ActList from '../../components/ActList.astro';
import { musicians, musicianBySlug, isPlaying, playingVenues, typeLabel, genreName, listJoin, musicianJsonLd } from '../../lib/site.js';

export function getStaticPaths() {
  return musicians.map((m) => ({ params: { slug: m.slug } }));
}
const m = musicianBySlug(Astro.params.slug);
const label = typeLabel(m);
const where = playingVenues(m).map((v) => v.name);
const members = (m.members || []).map(musicianBySlug).filter(Boolean);
const memberOf = (m.memberOf || []).map(musicianBySlug).filter(Boolean);
const LINKS = [['website', 'Website'], ['facebook', 'Facebook'], ['instagram', 'Instagram'], ['youtube', 'YouTube']];
const links = LINKS.filter(([k]) => m.links[k]);
const similar = musicians
  .filter((x) => x.slug !== m.slug && x.genres.some((g) => m.genres.includes(g)))
  .map((x) => ({ x, score: x.genres.filter((g) => m.genres.includes(g)).length }))
  .sort((a, b) => b.score - a.score || a.x.name.localeCompare(b.x.name))
  .slice(0, 6)
  .map((s) => s.x);
const genreText = m.genres.length ? listJoin(m.genres.map((g) => genreName(g).toLowerCase())) : 'live music';
const description = `${m.name}${label ? `, a ${label.toLowerCase()}` : ''} from the Las Cruces music scene playing ${genreText}. Links, band info and where they're playing this week.`;
---
<Layout title={`${m.name}, ${label || 'Musician'} in Las Cruces, NM`} {description} jsonLd={[musicianJsonLd(m)]} searchable>
  <div class="wrap">
    <p class="crumbs" data-pagefind-ignore><a href="/">Home</a> / <a href="/musicians/">Musicians</a> / {m.name}</p>
    <article class="grid">
      <div class="main stack">
        <header class="stack">
          {isPlaying(m) && <p class="playing">Playing this week</p>}
          <h1 data-pagefind-meta="title">{m.name}</h1>
          <p class="kind">{label ? `${label} from the Las Cruces music scene` : 'Part of the Las Cruces music scene'}</p>
        </header>

        {m.sound && (
          <figure class="sound">
            <blockquote>{m.sound.replace(/\.$/, '')}</blockquote>
            <figcaption>The sound, in a few words</figcaption>
          </figure>
        )}

        {m.genres.length > 0 && (
          <div class="tags" aria-label="Genres">
            {m.genres.map((g) => <a class="tag" href={`/genres/${g}/`}>{genreName(g)}</a>)}
          </div>
        )}

        {links.length > 0 ? (
          <div class="links btns">
            {links.map(([k, name]) => <a class="btn btn-line" href={m.links[k]} rel="noopener">{name}</a>)}
          </div>
        ) : (
          <p class="muted">No links yet. <a href="/get-listed/">Are you {m.name}? Send yours.</a></p>
        )}

        {members.length > 0 && <p><strong>Members:</strong> {members.map((x, i) => <>{i > 0 && ', '}<a href={`/musicians/${x.slug}/`}>{x.name}</a></>)}</p>}
        {memberOf.length > 0 && <p><strong>Also plays in:</strong> {memberOf.map((x, i) => <>{i > 0 && ', '}<a href={`/musicians/${x.slug}/`}>{x.name}</a></>)}</p>}
      </div>

      <div class="side stack">
        {isPlaying(m) ? (
          <ThisWeek
            heading={where.length ? `${m.name} is playing ${listJoin(where)} this week.` : `${m.name} is on stage this week.`}
            source={`musician_${m.slug}`}
          />
        ) : (
          <ThisWeek
            heading={`Catch ${m.name} live.`}
            body="When they're booked, they'll be in the Thursday Live Music issue with every other show in town."
            source={`musician_${m.slug}`}
          />
        )}
        <aside class="claim" data-pagefind-ignore>
          <p class="claim-head">Is this you?</p>
          <p>Your free listing is live. Upgrade to add photos, a song player, your story and a booking form that emails you directly.</p>
          <a href="/get-listed/">See listing options</a>
        </aside>
      </div>
    </article>

    {similar.length > 0 && (
      <section class="more" data-pagefind-ignore>
        <h2>If you like {m.name}</h2>
        <ActList acts={similar} />
      </section>
    )}
  </div>
</Layout>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr); gap: 48px; padding: 20px 0 56px; align-items: start; }
  h1 { font-size: clamp(3rem, 8vw, 6.4rem); overflow-wrap: anywhere; }
  .kind { font-size: 1.15rem; color: var(--muted); }
  .sound { margin: 8px 0; padding: 20px 0 0; border-top: 2px solid var(--ink); }
  .sound blockquote { margin: 0; font: 700 clamp(1.6rem, 3.2vw, 2.4rem)/1.05 var(--display); color: var(--turq); }
  .sound blockquote::before { content: '“'; } .sound blockquote::after { content: '”'; }
  .sound figcaption { margin-top: 8px; font-size: 0.9rem; color: var(--muted); }
  .links { margin-top: 8px; }
  .muted { color: var(--muted); }
  .claim { border: 1px dashed var(--turq); border-radius: 10px; padding: 22px; display: grid; gap: 8px; }
  .claim-head { font: 800 1.5rem/1 var(--display); }
  .more { padding-bottom: 72px; }
  .more h2 { margin-bottom: 18px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
