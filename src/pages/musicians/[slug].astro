---
import MusicianPage from '../../components/MusicianPage.astro';
import { musicians, musicianBySlug } from '../../lib/site.js';

export function getStaticPaths() {
  return musicians.map((m) => ({ params: { slug: m.slug } }));
}
const m = musicianBySlug(Astro.params.slug);
---
<MusicianPage m={m} />
