---
// Every act as a card. 12 at a time with a "Show more" button; search and filters cover them all.
// Order: claimed acts always first (playing this week or next, then with a photo, then the rest),
// then unclaimed acts (playing first). Local before regional/touring inside each group. Shuffled
// inside each group on every visit, so the shuffle never moves an unclaimed act above a claimed one.
// Featured (paid) acts stay first in their group.
// Every card is in the HTML, so all profile links stay crawlable even when hidden.
import Layout from '../../layouts/Layout.astro';
import ActCard from '../../components/ActCard.astro';
import Stage from '../../components/Stage.astro';
import { SITE, musicians, genres, playingActs, thisWeek, WHEN_SHORT, isPlaying, isFeatured, issueLink } from '../../lib/site.js';

const PER_PAGE = 12;
const hasPhoto = (m) => Boolean(m.card || m.photo);
// Same test the act's own page uses for "Claim this page" vs "Edit this page"
const isClaimed = (m) => Boolean(m.claimed || m.photo || m.bio);
const group = (m) => [isClaimed(m) ? 0 : 1, isPlaying(m) ? 0 : 1, isFeatured(m) ? 0 : 1, hasPhoto(m) ? 0 : 1, m.homeBase && m.homeBase !== 'local' ? 1 : 0].join('');
const acts = [...musicians].sort((a, b) => group(a).localeCompare(group(b)) || a.name.localeCompare(b.name));
const claimUrl = (m) => `/claim/?id=${m.notionId}&name=${encodeURIComponent(m.name)}`;
const typeKey = (m) => (m.type === 'Band' ? 'band' : m.type === 'Solo Artist' ? 'solo' : 'other');
---
<Layout title="Local Musicians & Bands" description={`All ${musicians.length} local musicians and bands in Las Cruces and Mesilla, NM. Filter by genre, bands or solo artists, and see who's playing this week and next.`}>
  <section class="hero night on-night">
    <Stage />
    <div class="wrap inner">
      <p class="crumbs"><a href="/">Home</a> / Musicians</p>
      <h1>Every act in the valley</h1>
      <p class="sub">{musicians.length} local musicians and bands.{playingActs.length > 0 && ` The ${playingActs.length} playing ${WHEN_SHORT} are up top.`}</p>
    </div>
  </section>

  <div class="wrap">
    <aside class="nudge" aria-label="For musicians">
      <p><strong>Play around here?</strong> Claimed pages show up first. Find your act below and tap “Claim it,” add a photo, then add your shows so you get the “Playing this week” badge.</p>
      <div class="btns">
        <a class="btn btn-chile" href="/get-listed/">Not listed? Get listed free</a>
        <a class="btn btn-line" href={SITE.eventsUrl}>Add your shows</a>
      </div>
    </aside>

    <header class="top stack">
      <h2>Find an act</h2>
      <p class="lede">Pick a sound, or type a name.</p>
    </header>

    <form class="filters" role="search" onsubmit="return false" data-pagefind-ignore>
      <label class="search">
        <span class="sr-only">Search by name or sound</span>
        <input type="search" id="q" placeholder="Search by name or sound, like “cumbia” or “Calista”" autocomplete="off" />
      </label>
      <fieldset class="row">
        <legend class="sr-only">Act type</legend>
        <button type="button" class="chip" data-type="all" aria-pressed="true">All</button>
        <button type="button" class="chip" data-type="band" aria-pressed="false">Bands</button>
        <button type="button" class="chip" data-type="solo" aria-pressed="false">Solo artists</button>
        {thisWeek.shows > 0 && <button type="button" class="chip hot" id="playing" aria-pressed="false">Playing {WHEN_SHORT} ({playingActs.length})</button>}
      </fieldset>
      <fieldset class="row genres">
        <legend class="sr-only">Genre</legend>
        <button type="button" class="chip" data-genre="" aria-pressed="true">Every genre</button>
        {genres.map((g) => <button type="button" class="chip" data-genre={g.slug} aria-pressed="false">{g.name}</button>)}
      </fieldset>
    </form>

    <p class="count" id="count" aria-live="polite">{musicians.length} acts</p>
    <ul class="cards" id="cards" aria-label="Local acts">
      {acts.map((m, i) => (
        <li
          data-group={group(m)}
          data-pin={isFeatured(m) ? '1' : undefined}
          data-name={m.name.toLowerCase()}
          data-sound={(m.sound || '').toLowerCase()}
          data-genres={m.genres.join(' ')}
          data-type={typeKey(m)}
          data-playing={isPlaying(m) ? '1' : '0'}
          hidden={i >= PER_PAGE}
        >
          <ActCard m={m} />
          {isPlaying(m)
            ? <a class="more-link" href={issueLink(`musicians_${m.slug}`)}>See when &amp; where →</a>
            : !isClaimed(m) && <a class="more-link claim" href={claimUrl(m)}>Is this you? Claim it free</a>}
        </li>
      ))}
    </ul>
    <p class="empty" id="empty" hidden>No acts match that. Try another genre, or <a href="/get-listed/">tell me who's missing</a>.</p>
    <div class="show-more"><button type="button" class="btn btn-line" id="more" hidden>Show more acts</button></div>
  </div>
</Layout>

<script>
  const PER_PAGE = 12;
  const list = document.getElementById('cards')!;
  const q = document.getElementById('q') as HTMLInputElement;
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const more = document.getElementById('more') as HTMLButtonElement;
  const playingBtn = document.getElementById('playing');
  const state = { type: 'all', genre: '', playing: false, q: '' };
  let limit = PER_PAGE;

  // Shuffle inside each group (claimed acts' groups always sort first), so every act gets its turn
  // near the top of its group without an unclaimed act jumping a claimed one. Featured stay first.
  const all = [...list.children] as HTMLLIElement[];
  const byGroup = new Map<string, HTMLLIElement[]>();
  for (const li of all) {
    const g = li.dataset.group || '';
    if (!byGroup.has(g)) byGroup.set(g, []);
    byGroup.get(g)!.push(li);
  }
  const shuffle = (a: HTMLLIElement[]) => {
    for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
    return a;
  };
  const items = [...byGroup.keys()].sort().flatMap((g) => {
    const list = byGroup.get(g)!;
    return [...list.filter((li) => li.dataset.pin), ...shuffle(list.filter((li) => !li.dataset.pin))];
  });
  items.forEach((li) => list.appendChild(li));

  // Deep links: /musicians/?genre=blues&playing=1
  const params = new URLSearchParams(location.search);
  if (params.get('genre')) state.genre = params.get('genre')!;
  if (params.get('playing') === '1') state.playing = true;
  if (params.get('q')) { state.q = params.get('q')!; q.value = state.q; }

  function render() {
    const words = state.q.toLowerCase().trim();
    let matched = 0;
    let shown = 0;
    for (const li of items) {
      const d = li.dataset;
      const ok = (state.type === 'all' || d.type === state.type)
        && (!state.genre || (d.genres || '').split(' ').includes(state.genre))
        && (!state.playing || d.playing === '1')
        && (!words || (d.name || '').includes(words) || (d.sound || '').includes(words));
      if (ok) matched++;
      const show = ok && matched <= limit;
      li.hidden = !show;
      if (show) shown++;
    }
    count.textContent = shown < matched ? `Showing ${shown} of ${matched} acts` : `${matched} ${matched === 1 ? 'act' : 'acts'}`;
    empty.hidden = matched > 0;
    more.hidden = shown >= matched;
    document.querySelectorAll<HTMLButtonElement>('button[data-type]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.type === state.type)));
    document.querySelectorAll<HTMLButtonElement>('button[data-genre]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.genre === state.genre)));
    playingBtn?.setAttribute('aria-pressed', String(state.playing));
    const p = new URLSearchParams();
    if (state.genre) p.set('genre', state.genre);
    if (state.playing) p.set('playing', '1');
    if (state.q) p.set('q', state.q);
    history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
  }
  // A new filter starts back at the first 12
  const update = () => { limit = PER_PAGE; render(); };

  document.querySelectorAll<HTMLButtonElement>('button[data-type]').forEach((b) => b.addEventListener('click', () => { state.type = b.dataset.type!; update(); }));
  document.querySelectorAll<HTMLButtonElement>('button[data-genre]').forEach((b) => b.addEventListener('click', () => { state.genre = b.dataset.genre!; update(); }));
  playingBtn?.addEventListener('click', () => { state.playing = !state.playing; update(); });
  q.addEventListener('input', () => { state.q = q.value; update(); });
  more.addEventListener('click', () => {
    const before = items.filter((li) => !li.hidden).length;
    limit += PER_PAGE;
    render();
    // Move keyboard focus to the first new card
    items.filter((li) => !li.hidden)[before]?.querySelector('a')?.focus({ preventScroll: true });
  });
  render();
</script>

<style>
  .hero { padding: clamp(40px, 6vw, 72px) 0 clamp(48px, 7vw, 88px); position: relative; overflow: hidden; }
  .inner { position: relative; z-index: 1; display: grid; gap: 14px; }
  .hero .crumbs a, .hero .crumbs { color: #cfc8de; }
  .hero h1 { color: var(--cream); }
  .sub { font-size: 1.2rem; }
  .nudge { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 24px; margin-top: clamp(24px, 4vw, 40px); padding: 18px 22px; border-radius: 8px; background: var(--cream); border-left: 6px solid var(--gold); }
  .nudge p { margin: 0; max-width: 62ch; }
  .nudge .btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .top { padding: 40px 0 24px; }
  .filters { display: grid; gap: 14px; margin-bottom: 18px; }
  .search input { width: 100%; font: 400 1.1rem var(--text); padding: 15px 16px; border: 2px solid var(--ink); border-radius: 6px; background: var(--paper); color: var(--ink); }
  .row { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font: 600 0.92rem/1 var(--text); padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--paper); color: var(--ink); cursor: pointer; }
  .chip:hover { border-color: var(--turq); }
  .chip[aria-pressed='true'] { background: var(--turq); border-color: var(--turq); color: #fff; }
  .chip.hot { border-color: var(--chile); color: var(--chile); }
  .chip.hot[aria-pressed='true'] { background: var(--chile); color: #fff; }
  .count { color: var(--muted); font-size: 0.95rem; margin-bottom: 12px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
  .cards li { display: grid; gap: 8px; align-content: start; }
  .cards li[hidden] { display: none; }
  .more-link { font-size: 0.92rem; font-weight: 700; color: var(--turq); }
  .more-link.claim { color: var(--chile); }
  .show-more { display: flex; justify-content: center; padding: 32px 0 72px; }
  .empty { padding-top: 12px; }
  @media (max-width: 560px) {
    .cards { grid-template-columns: 1fr 1fr; gap: 12px; }
    .more-link { font-size: 0.8rem; }
  }
</style>
