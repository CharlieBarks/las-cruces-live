---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" description="That page isn't here." noindex>
  <div class="wrap" style="padding: 64px 0 96px; display: grid; gap: 16px; justify-items: start;">
    <h1>Wrong stage.</h1>
    <p class="lede">That page moved or never existed. Try the musicians list or search.</p>
    <div class="btns"><a class="btn btn-chile" href="/musicians/">Browse musicians</a><a class="btn btn-line" href="/search/">Search</a></div>
  </div>
</Layout>
