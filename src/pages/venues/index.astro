---
import Layout from '../../layouts/Layout.astro';
import SponsorBand from '../../components/SponsorBand.astro';
import VenueCard from '../../components/VenueCard.astro';
import { venues, AREAS, SPONSORS, isFeaturedVenue, featuredVenueFirst } from '../../lib/site.js';
const groups = Object.entries(AREAS)
  .map(([k, a]) => ({ k, a, list: featuredVenueFirst(venues.filter((v) => v.area === k)) }))
  .filter((g) => g.list.length);
// Sponsor venues up top, in the order of SPONSORS.liveMusic
const sponsorOrder = (SPONSORS.liveMusic || []).map((s) => s.venue);
const sponsorVenues = venues.filter(isFeaturedVenue)
  .sort((a, b) => ((sponsorOrder.indexOf(a.slug) + 1) || 99) - ((sponsorOrder.indexOf(b.slug) + 1) || 99));
---
<Layout title="Live Music Venues" description={`${venues.length} places to hear live music in Las Cruces, Mesilla, the South Valley wineries and Hatch, grouped by neighborhood.`}>
  <SponsorBand source="venues" />
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / Venues</p>
    <header class="top stack">
      <h1>Where to hear live music</h1>
      <p class="lede">{venues.length} stages, patios and dance floors, by neighborhood. <a href="/map/">See them on the map.</a></p>
      <nav class="jump" aria-label="Neighborhoods">
        {groups.map((g) => <a class="tag" href={`#${g.k}`}>{g.a.name}</a>)}
      </nav>
    </header>
    {sponsorVenues.length > 0 && (
      <section class="sponsors" aria-labelledby="sp-title">
        <h2 id="sp-title" class="sp-label">Our sponsors</h2>
        <ul class="vsponsors">{sponsorVenues.map((v) => <li><VenueCard v={v} wide /></li>)}</ul>
      </section>
    )}
    {groups.map((g) => (
      <section class="area" id={g.k}>
        <div class="area-head">
          <h2>{g.a.name}</h2>
          <p>{g.a.blurb}</p>
        </div>
        <ul class="vcards">
          {g.list.map((v) => <li><VenueCard v={v} /></li>)}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .top { padding: 18px 0 32px; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .sponsors { padding-bottom: 40px; display: grid; gap: 14px; }
  .sp-label { font: 700 0.85rem var(--text); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .vsponsors { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 20px; }
  .area { display: grid; gap: 20px; padding: 32px 0; border-top: 2px solid var(--ink); scroll-margin-top: 20px; }
  .area:last-child { padding-bottom: 80px; }
  .area-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 20px; }
  .area-head p { color: var(--muted); }
  .vcards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  @media (max-width: 560px) { .vcards { grid-template-columns: 1fr 1fr; gap: 12px; } }
</style>
