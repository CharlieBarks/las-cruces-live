---
import Layout from '../../layouts/Layout.astro';
import FeaturedVenue from '../../components/FeaturedVenue.astro';
import { venues, AREAS, venueWeek, whenText, featuredVenues, featuredFirst, isFeatured } from '../../lib/site.js';
const groups = Object.entries(AREAS)
  .map(([k, a]) => ({ k, a, list: featuredFirst(venues.filter((v) => v.area === k)) }))
  .filter((g) => g.list.length);
---
<Layout title="Live Music Venues" description={`${venues.length} places to hear live music in Las Cruces, Mesilla, the South Valley wineries and Hatch, grouped by neighborhood.`}>
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / Venues</p>
    <header class="top stack">
      <h1>Where to hear live music</h1>
      <p class="lede">{venues.length} stages, patios and dance floors, by neighborhood. <a href="/map/">See them on the map.</a></p>
      <nav class="jump" aria-label="Neighborhoods">
        {groups.map((g) => <a class="tag" href={`#${g.k}`}>{g.a.name}</a>)}
      </nav>
    </header>
    {featuredVenues.length > 0 && (
      <section class="fband">
        <h2>Featured venues</h2>
        <div class="fgrid">{featuredVenues.map((v) => <FeaturedVenue v={v} source="venues" />)}</div>
      </section>
    )}
    {groups.map((g) => (
      <section class="area" id={g.k}>
        <div class="area-head">
          <h2>{g.a.name}</h2>
          <p>{g.a.blurb}</p>
        </div>
        <ul class="vlist">
          {g.list.map((v) => {
            const w = venueWeek(v);
            return (
              <li class={isFeatured(v) ? 'feat' : undefined}>
                <a href={`/venues/${v.slug}/`}>{v.name}{isFeatured(v) && <em class="ftag">Featured</em>}</a>
                <span class="addr">{v.address ? v.address.replace(/,\s*NM\s*\d{5}$/, '') : ''}</span>
                {w.shows > 0 && <span class="playing">{w.shows} {w.shows === 1 ? 'show' : 'shows'} {whenText(w.weeks, true)}</span>}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .top { padding: 18px 0 32px; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .fband { padding: 8px 0 40px; }
  .fband h2 { margin-bottom: 18px; }
  .fgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .vlist li.feat { background: rgba(244,182,62,.12); box-shadow: inset 4px 0 0 var(--gold); padding-left: 12px; }
  .ftag { font: 700 .72rem var(--text); font-style: normal; background: var(--gold); color: var(--night); padding: 3px 8px; border-radius: 999px; margin-left: 10px; vertical-align: .3em; }
  .area { display: grid; grid-template-columns: minmax(220px, 1fr) 2fr; gap: 32px; padding: 32px 0; border-top: 2px solid var(--ink); scroll-margin-top: 20px; }
  .area:last-child { padding-bottom: 80px; }
  .area-head p { margin-top: 10px; color: var(--muted); }
  .vlist { list-style: none; margin: 0; padding: 0; }
  .vlist li { display: grid; grid-template-columns: 1fr auto; gap: 2px 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .vlist a { font: 700 1.5rem/1.05 var(--display); color: var(--ink); text-decoration: none; }
  .vlist a:hover { color: var(--turq); }
  .addr { grid-column: 1; color: var(--muted); font-size: 0.92rem; }
  .vlist .playing { grid-column: 2; grid-row: 1; }
  @media (max-width: 760px) { .area { grid-template-columns: 1fr; gap: 12px; } }
</style>
