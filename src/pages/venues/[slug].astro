---
import Layout from '../../layouts/Layout.astro';
import ThisWeek from '../../components/ThisWeek.astro';
import VenueMap from '../../components/VenueMap.astro';
import Comments from '../../components/Comments.astro';
import CrowdPhotos from '../../components/CrowdPhotos.astro';
import PinnedPosts from '../../components/PinnedPosts.astro';
import { SITE, utm, out, venues, venueBySlug, venueWeek, musicianBySlug, AREAS, mapsLink, whenText, listJoin, venueJsonLd, isFeaturedVenue, isSponsorVenue, featuredVenueFirst } from '../../lib/site.js';

export function getStaticPaths() {
  return venues.map((v) => ({ params: { slug: v.slug } }));
}
const v = venueBySlug(Astro.params.slug);
const area = AREAS[v.area];
const w = venueWeek(v);
const acts = w.acts.map(musicianBySlug).filter(Boolean);
const LINKS = [['website', 'Website'], ['facebook', 'Facebook'], ['instagram', 'Instagram']];
const links = LINKS.filter(([k]) => v.links[k]);
const feat = isFeaturedVenue(v);
const nearby = featuredVenueFirst(venues.filter((x) => x.area === v.area && x.slug !== v.slug)).slice(0, 6);
const sponsor = isSponsorVenue(v);
// Everyone playing: acts with a page here (linked), then performers by the name in the issue
const otherNames = w.others || [];
const allNames = [...acts.map((a) => a.name), ...otherNames];
const missing = Math.max(0, (w.unlisted ?? 0) - otherNames.length);
const when = whenText(w.weeks);
const heading = allNames.length > 4
  ? `${w.shows} shows at ${v.name} ${when}. Here's who's playing.`
  : allNames.length
  ? `${listJoin(allNames)}${missing > 0 ? `, plus ${missing} more ${missing === 1 ? 'show' : 'shows'}` : ''}.`
  : `${w.shows} ${w.shows === 1 ? 'show' : 'shows'} at ${v.name} ${when}.`;
// Who's playing, split by week: this week first, next week (if the issue has it) folded below
const weekLists = (w.byWeek || []).map((x, i) => ({
  label: i === 0 ? 'this week' : 'next week',
  acts: x.acts.map(musicianBySlug).filter(Boolean),
  others: x.others,
})).filter((x) => x.acts.length + x.others.length > 0);
const lllc = utm('https://livelovelascruces.com/', `venue_${v.slug}_sponsor`);
---
<Layout title={`${v.name}, Live Music in ${area?.name === 'Old Mesilla' ? 'Mesilla' : 'Las Cruces'}`} description={`Live music at ${v.name}${v.address ? `, ${v.address}` : ''}. Links, directions and who's playing this week and next.`} jsonLd={[venueJsonLd(v)]} searchable>
  <div class="wrap">
    <p class="crumbs" data-pagefind-ignore><a href="/">Home</a> / <a href="/venues/">Venues</a> / {v.name}</p>
    <article class:list={['grid', { feat }]}>
      <div class="main stack">
        {v.photo && <img class="vphoto" src={v.photo} alt={v.name} width="1200" height="900" decoding="async" fetchpriority="high" />}
        {(feat || w.shows > 0) && (
          <div class="tags">
            {sponsor ? <a class="fpill" href={lllc} rel="noopener">★ Proud sponsor of Live Love Las Cruces</a> : feat && <p class="fpill">Featured venue</p>}
            {w.shows > 0 && <p class="playing">Live music {whenText(w.weeks, true)}</p>}
          </div>
        )}
        <h1>{v.name}</h1>
        <p class="kind"><a href={`/venues/#${v.area}`}>{area?.name}</a></p>
        <dl class="facts">
          {v.address && <><dt>Address</dt><dd>{v.address}<br /><a href={mapsLink(v)} rel="noopener">Get directions</a></dd></>}
          {v.phone && <><dt>Phone</dt><dd><a href={`tel:${v.phone.replace(/[^\d+]/g, '')}`}>{v.phone}</a></dd></>}
        </dl>
        {links.length > 0 && <div class="btns">{links.map(([k, n]) => <a class="btn btn-line" href={out(v.links[k], v.slug)} rel="noopener">{n}</a>)}</div>}
        {v.lat && v.lng && <div class="mini"><VenueMap list={[v]} height="300px" zoom={14} /></div>}
      </div>
      <div class="side stack">
        {w.shows > 0 ? (
          <ThisWeek heading={heading} source={`venue_${v.slug}`} when={whenText(w.weeks, true)} />
        ) : (
          <ThisWeek idle heading={`See who's playing ${v.name}.`} body="Every Thursday the Live Music issue lists the week's shows here and all over town." source={`venue_${v.slug}`} />
        )}
        {weekLists.length > 0 && (
          <div class="acts-here" data-pagefind-ignore>
            {weekLists.map((wk, i) => {
              const list = (
                <ul>
                  {wk.acts.map((a) => <li><a href={`/musicians/${a.slug}/`}>{a.name} <span class="go" aria-hidden="true">→</span></a></li>)}
                  {wk.others.map((n) => <li><span class="nolink">{n}</span></li>)}
                </ul>
              );
              // This week shows open; next week sits folded under it when both are in the issue
              return i === 0 || weekLists.length === 1
                ? <><p class="label">Playing here {wk.label}</p>{list}</>
                : <details class="next"><summary>See who's playing here {wk.label} ({wk.acts.length + wk.others.length})</summary>{list}</details>;
            })}
            {weekLists.some((wk) => wk.others.length) && <p class="addme">Playing here without a page? <a class="addlink" href="/get-listed/">Get one free →</a></p>}
          </div>
        )}
        {sponsor && (
          <aside class="sponsor-box" data-pagefind-ignore>
            <a href={lllc} rel="noopener"><img src="/lllc-logo-on-light.png" alt="Live Love Las Cruces" width="200" height="50" loading="lazy" /></a>
            <p><strong>{v.name} is a proud sponsor of Live Love Las Cruces</strong>, helping bring every show in town to 10,000+ locals in Thursday's free Live Music issue. Thank you!</p>
          </aside>
        )}
        <aside class="shows-cta" data-pagefind-ignore>
          <p><strong>Got shows coming up?</strong> <a href={utm(SITE.eventsUrl, `venue_${v.slug}`)} rel="noopener">Make sure we know about it: add it to the Events Calendar →</a></p>
        </aside>
        {!feat && <aside class="claim" data-pagefind-ignore>
          <p class="claim-head">Run this venue?</p>
          <p>Featured venue pages are coming soon, with photos, your regular music nights and a gold pin on the map. Sponsor spots are open now.</p>
          <a href="/get-listed/#venues">See venue options</a>
        </aside>}
      </div>
    </article>
    <PinnedPosts record={v} about={v.name} />
    <CrowdPhotos record={v} kind="venue" about={v.name} />
    <Comments record={v} kind="venue" about={v.name} prompt={`What do you love about ${v.name}?`} placeholder="The patio, the crowd, the music, the best night you had there…" />
    {nearby.length > 0 && (
      <section class="nearby" data-pagefind-ignore>
        <h2>More in {area?.name}</h2>
        <ul>{nearby.map((x) => <li><a href={`/venues/${x.slug}/`}>{x.name}</a>{isFeaturedVenue(x) && <em class="ftag">Featured</em>}</li>)}</ul>
      </section>
    )}
  </div>
</Layout>

<style>
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  a.fpill { text-decoration: none; }
  a.fpill:hover { background: var(--night); color: var(--gold); }
  .acts-here .nolink { display: block; padding: 8px 0; font: 700 1.35rem/1.1 var(--display); color: var(--muted); }
  .acts-here .go { color: var(--turq); font-size: 1.1rem; }
  .acts-here a.addlink { display: inline; padding: 0; font: 700 .92rem var(--text); color: var(--turq); text-decoration: underline; }
  .next { margin-top: 14px; }
  .next summary { cursor: pointer; font-weight: 700; color: var(--turq); min-height: 44px; display: flex; align-items: center; }
  .next summary:hover { text-decoration: underline; }
  .addme { margin-top: 10px; font-size: .92rem; color: var(--muted); }
  .sponsor-box { display: grid; gap: 10px; padding: 20px; border-radius: 10px; background: var(--cream); box-shadow: inset 0 0 0 3px var(--gold); }
  .sponsor-box img { display: block; width: 180px; height: auto; }
  .fpill { justify-self: start; display: inline-block; background: var(--gold); color: var(--night); font-weight: 700; font-size: .85rem; padding: 5px 12px; border-radius: 999px; }
  .feat h1 { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 8px; text-underline-offset: 6px; text-decoration-skip-ink: none; }
  .ftag { font: 700 .7rem var(--text); font-style: normal; background: var(--gold); color: var(--night); padding: 2px 7px; border-radius: 999px; margin-left: 8px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr); gap: 48px; padding: 20px 0 56px; align-items: start; }
  h1 { font-size: clamp(3rem, 7.5vw, 6rem); }
  .kind { font-size: 1.15rem; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 10px 20px; margin: 8px 0 0; padding-top: 18px; border-top: 2px solid var(--ink); }
  dt { font-weight: 700; } dd { margin: 0; }
  .mini { margin-top: 12px; }
  .vphoto { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 25%; border-radius: 8px; }
  .acts-here .label { font-weight: 700; margin-bottom: 6px; }
  .acts-here ul { list-style: none; padding: 0; margin: 0; }
  .acts-here li { border-bottom: 1px solid var(--line); }
  .acts-here a { display: block; padding: 8px 0; font: 700 1.35rem/1.1 var(--display); color: var(--ink); text-decoration: none; }
  .acts-here a:hover { color: var(--turq); }
  .shows-cta { padding: 14px 18px; border-left: 4px solid var(--chile); background: var(--paper); border-radius: 8px; }
  .claim { border: 1px dashed var(--turq); border-radius: 10px; padding: 22px; display: grid; gap: 8px; }
  .claim-head { font: 800 1.5rem/1 var(--display); }
  .nearby { padding-bottom: 72px; }
  .nearby ul { columns: 3 220px; padding-left: 18px; margin-top: 14px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
