---
import Layout from '../layouts/Layout.astro';
import { SITE, utm, FORM_URL } from '../lib/site.js';
const mail = (subject, body, bcc) => `mailto:${SITE.contactEmail}?subject=${encodeURIComponent(subject)}${bcc ? `&bcc=${encodeURIComponent(bcc)}` : ''}${body ? `&body=${encodeURIComponent(body)}` : ''}`;
---
<Layout title="Get Listed" description="Free listings for Las Cruces musicians, bands and live music venues. Add your act, or claim your page to add photos, band members and a song.">
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a> / Get listed</p>
    <header class="top stack">
      <h1>Get on the lineup</h1>
      <p class="lede">If you play music or host it in the Mesilla Valley, you get a free listing. Always. No pay-to-play. Just the whole scene, in one place.</p>
    </header>

    <aside class="shows-note" id="shows">
      <p class="shows-head">Heads up: your listing doesn't add your shows.</p>
      <p>Every week we dig through Instagram, Facebook and venue websites hunting for live music, and we still miss stuff. If your gig isn't on our radar, it isn't in the Thursday Live Music issue.</p>
      <p>The surest way in? Add your shows to the LLLC Events Calendar. It takes two minutes, and {SITE.subscribers} locals read the newsletter they feed. Got a regular weekly gig? Add it once as a recurring event and you're set.</p>
      <a class="btn btn-chile" href={utm(SITE.eventsUrl, 'getlisted_shows')} rel="noopener">Add my shows to the calendar</a>
    </aside>

    <section class="block" id="musicians">
      <h2>Musicians and bands</h2>
      <div class="cols">
        <div class="plan featured">
          <p class="plan-name">New here? Add your act</p>
          <p class="price">Free, forever</p>
          <ul>
            <li>Your own page: photos, your story and your sound in your own words</li>
            <li>A song people can play right on your page</li>
            <li>Your band members, each with a photo and a line about them</li>
            <li>Genres, website and social links</li>
            <li>A “Playing this week” badge whenever you're in the Thursday issue</li>
          </ul>
          <a class="btn btn-chile" href={FORM_URL} rel="noopener">Add my act</a>
          <p class="small">About 3 minutes. I'll email you a private link to make changes anytime.</p>
        </div>
        <div class="plan">
          <p class="plan-name">Already on the site? Claim it</p>
          <p class="price">Also free</p>
          <ul>
            <li>Find your page and tap <strong>Claim this page</strong></li>
            <li>I'll email you a private link to your page</li>
            <li>Add photos, your bio, a song and your band members, and fix anything that's off</li>
          </ul>
          <a class="btn btn-line" href="/musicians/">Find my page</a>
          <p class="small">Listed alphabetically. Nobody pays to cut the line.</p>
        </div>
      </div>
    </section>

    <section class="block" id="venues">
      <h2>Venues</h2>
      <div class="cols">
        <div class="plan">
          <p class="plan-name">Free listing</p>
          <p class="price">$0</p>
          <ul>
            <li>Your page with address, directions, phone and links</li>
            <li>A pin on the venue map</li>
            <li>Your shows-this-week count, straight from the Thursday issue</li>
          </ul>
          <a class="btn btn-line" href={mail('Las Cruces Live: venue listing')}>Add or fix my venue</a>
        </div>
        <div class="plan featured">
          <p class="soon">Coming soon</p>
          <p class="plan-name">Featured venue</p>
          <p class="price">From $29 a month</p>
          <ul>
            <li>Photos and the vibe of the place</li>
            <li>Your regular music nights, like “Jazz Thursdays”</li>
            <li>A gold featured pin on the map</li>
            <li>Top spot in your neighborhood list</li>
          </ul>
          <p>Featured venue pages are on the way. Want to hear first? <a href={mail('Las Cruces Live: featured venue')}>Drop me a line</a>.</p>
        </div>
      </div>

      <div class="sponsors">
        <h3>Sponsor a page</h3>
        <p>One sponsor per spot, so yours never gets lost in a crowd.</p>
        <ul>
          <li><strong>Homepage banner</strong>, rotating with up to two others</li>
          <li><strong>A genre page</strong>, like “Blues in Las Cruces, presented by you”</li>
          <li><strong>A neighborhood</strong>: Old Mesilla, Downtown, the West Side and more</li>
          <li><strong>The venue map</strong>, “presented by” at the top</li>
          <li><strong>Venue of the Month</strong> spotlight</li>
        </ul>
        <p>Best value: pair a sponsor spot with a mention in the Thursday Live Music issue, read by {SITE.subscribers} subscribers.</p>
        <a class="btn btn-chile" href={mail('Las Cruces Live: sponsorship')}>Ask about sponsoring</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .top { padding: 18px 0 24px; }
  .shows-note { margin: 0 0 36px; padding: 24px 28px; border-left: 6px solid var(--chile); border-radius: 10px; background: var(--paper); display: grid; gap: 10px; justify-items: start; max-width: 70ch; }
  .shows-head { font: 800 1.7rem/1.05 var(--display); }
  .block { padding: 36px 0; border-top: 2px solid var(--ink); }
  .block:last-child { padding-bottom: 88px; }
  .block > h2 { margin-bottom: 24px; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .plan { padding: 28px; border-radius: 10px; background: var(--paper); border: 1px solid var(--line); display: grid; gap: 12px; align-content: start; justify-items: start; }
  .plan.featured { border: 2px solid var(--turq); }
  .plan-name { font: 800 1.9rem/1 var(--display); }
  .price { font-weight: 700; color: var(--turq); }
  .plan ul, .sponsors ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .soon { font: 700 0.8rem/1 var(--text); text-transform: uppercase; letter-spacing: 0.08em; color: #fff; background: var(--turq); padding: 6px 10px; border-radius: 999px; }
  .small { font-size: 0.9rem; color: var(--muted); }
  .sponsors { margin-top: 40px; display: grid; gap: 12px; justify-items: start; max-width: 70ch; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } }
</style>
